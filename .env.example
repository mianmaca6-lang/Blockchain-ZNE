# Copiar a .env y completar. NUNCA versionar .env ni ningún secreto.
# Generar valores seguros:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"                       (tokens / secreto seudónimo)
#   python -c "from app.services.cifrado import generar_clave_base64 as g;print(g())"  (clave AES-256)

# --- Base de datos ---
DATABASE_URL=sqlite:///./data/colmena.db
COLMENA_BACKUP_DIR=./backups

# --- Autenticación n8n -> FastAPI (header X-Api-Token). Obligatorio: sin él, la API responde 503.
COLMENA_API_TOKEN=

# --- Privacidad (Fase 1) ---
# Clave AES-256-GCM en base64 (32 bytes). PERDERLA = PERDER ACCESO A LOS REGISTROS PERSONALES.
# Guardar una copia fuera del servidor (gestor de contraseñas / caja fuerte), separada de los backups.
COLMENA_CLAVE_CIFRADO=
COLMENA_CLAVE_CIFRADO_VERSION=1
# Secreto (>= 32 caracteres) para el HMAC de los ids de Telegram. Distinto de la clave de cifrado.
COLMENA_SECRETO_SEUDONIMO=

# --- Soroban (Fase 1). Si faltan, los registros quedan en 'error_reintentable' (no se pierden).
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RED=testnet
SOROBAN_CONTRATO_LIBRO_PERSONAL=
# Ruta a un ARCHIVO con la llave secreta (S...) de la cuenta de servicio. No poner la llave aquí.
SOROBAN_LLAVE_SERVICIO_ARCHIVO=./secrets/soroban_servicio.txt
SOROBAN_TIMEOUT_S=60

# --- n8n (cliente saliente, ya existente) ---
N8N_BASE_URL=http://n8n:5678
N8N_API_TOKEN=
N8N_TIMEOUT=10

# --- Multifirma clásica (REVISAR: se reemplaza en fase posterior) ---
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_CUENTA_MULTISIG=
STELLAR_SOCIOS=
STELLAR_UMBRAL=2
APROBACION_TTL_HORAS=72

COLMENA_LOG_NIVEL=INFO
